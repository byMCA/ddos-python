*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
input{-webkit-user-select:text;user-select:text}
html,body{margin:0;width:100%;max-width:100%;overflow-x:hidden;overscroll-behavior-x:none;touch-action:manipulation;background:var(--bg);color:var(--tx);font:400 17px/1.35 -apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",Roboto,system-ui,sans-serif;-webkit-text-size-adjust:100%}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bar);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);z-index:30}
button,input,select{font:inherit;color:inherit;border:0;background:none;margin:0;padding:0;touch-action:manipulation}
button{cursor:pointer;text-align:left}
:focus-visible{outline:2px solid var(--ac);outline-offset:2px}
svg.i{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:0 0 auto;display:block}
.app{max-width:560px;margin:0 auto;min-width:0;padding-bottom:96px}
.bar{position:sticky;top:env(safe-area-inset-top,0px);z-index:25;height:44px;display:flex;align-items:center;justify-content:center;background:var(--bar);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);border-bottom:.5px solid transparent}
.bar.sc{border-color:var(--sp)}
.bt{font-weight:600;opacity:0;transition:opacity .2s}.bar.sc .bt{opacity:1}
.bk{position:absolute;left:6px;top:0;height:44px;color:var(--ac);padding:0 10px 0 4px;display:none;align-items:center;gap:2px}.bk.on{display:flex}
.pg{padding:0 16px}
h1{font-size:34px;line-height:1.1;font-weight:700;margin:4px 0 14px;letter-spacing:.3px;overflow-wrap:anywhere}
.sub{color:var(--mu);margin:-8px 0 12px;font-size:15px}
.view,.scr{display:none}.view.on,.scr.on{display:block}
.grp{background:var(--cd);border-radius:12px;overflow:hidden;margin:0 0 16px}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:52px;padding:8px 16px;position:relative;min-width:0}
.grp>.row+.row::before{content:"";position:absolute;left:16px;right:0;top:0;height:.5px;background:var(--sp)}
.pair{position:relative}.pair .row+.row::before{content:"";position:absolute;left:16px;right:0;top:0;height:.5px;background:var(--sp)}
.k{flex:0 0 auto}
.v{text-align:right;min-width:0;flex:1;display:flex;flex-direction:column;align-items:flex-end;color:var(--ac);padding-right:36px}
.v b{font-weight:500;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.v small{color:var(--mu);font-size:13px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.row input[type=date]{text-align:right;color:var(--ac);min-width:0;min-height:36px;font-size:17px;-webkit-appearance:none;appearance:none}
.swp{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:32px;height:32px;border-radius:50%;background:var(--cd);box-shadow:0 0 0 .5px var(--sp),0 1px 4px #0002;z-index:2;display:flex;align-items:center;justify-content:center;color:var(--ac)}
.step{display:flex;align-items:center;gap:14px}.step button{width:32px;height:32px;border-radius:50%;background:var(--sg);display:flex;align-items:center;justify-content:center}.step b{min-width:16px;text-align:center}
.seg{display:flex;background:var(--sg);border-radius:9px;padding:2px;margin:0 0 14px}.seg button{flex:1;text-align:center;padding:6px 4px;border-radius:7px;font-size:14px;font-weight:500;min-width:0}.seg button.on{background:var(--cd);box-shadow:0 1px 3px #0002}
.go{display:block;width:100%;height:52px;border-radius:14px;background:var(--ac);color:#fff;font-weight:600;text-align:center}
:root[data-theme="dark"] .go{color:#000}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .go{color:#000}}
.go:active{opacity:.8}
