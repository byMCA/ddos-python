/* Örnek veri üreteci (API_URL boşsa) */
function hash(s){let h=2166136261;for(const c of s){h^=c.charCodeAt(0);h=Math.imul(h,16777619)}return h>>>0}
function rng(s){return()=>{s|=0;s=s+0x6D2B79F5|0;let t=Math.imul(s^s>>>15,1|s);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function demo(a,b,date,ret,two){
 const A=BYC[a],B=BYC[b],r=rng(hash(a+b+date)),R=Math.PI/180;
 const km=12742*Math.asin(Math.sqrt(Math.sin((B.lat-A.lat)*R/2)**2+Math.cos(A.lat*R)*Math.cos(B.lat*R)*Math.sin((B.lon-A.lon)*R/2)**2));
 const lead=dd(date);let base=600+km*.6;base*=lead<7?1.35:lead<21?1.18:lead<45?1.05:1;
 const cs=["TK","PC","LH","AF","EK","BA","KL","QR","IB"].filter(c=>AIRN[c]),out=[];
 const seg=(f,t,d,h,m,du,c,n)=>{const s=new Date(d+"T00:00:00");s.setMinutes(h*60+m);const e=new Date(s.getTime()+du*6e4),p=x=>x.getFullYear()+"-"+String(x.getMonth()+1).padStart(2,"0")+"-"+String(x.getDate()).padStart(2,"0")+"T"+String(x.getHours()).padStart(2,"0")+":"+String(x.getMinutes()).padStart(2,"0")+":00";return{marketing_carrier_code:c,flight_number:String(n),operating_carrier_name:AIRN[c],departure_airport:f,departure_time_local:p(s),arrival_airport:t,arrival_time_local:p(e),duration_minutes:du}};
 cs.forEach(c=>{for(let i=0;i<(two?2:1);i++){
  const st=km<700?0:(r()<.6?0:1),du=Math.round(km/800*60+35+st*95),h=6+Math.floor(r()*15),m=Math.floor(r()*6)*10,lc=c=="PC"||c=="VF";
  const mk=(f,t,d)=>st?[seg(f,"XXX",d,h,m,Math.round(du/2),c,100+Math.floor(r()*800)),seg("XXX",t,d,h,m,Math.round(du/2),c,100+Math.floor(r()*800))]:[seg(f,t,d,h,m,du,c,100+Math.floor(r()*800))];
  const it={price:{amount:Math.round(base*(lc?.76:1+r()*.15)*(.92+r()*.16)*(ret?1.85:1)),currency:"TRY"},outbound:{carrier:AIRN[c],duration_minutes:du,segments:mk(a,b,date)},bags:{checked:lc?0:1}};
  if(ret)it.inbound={segments:mk(b,a,ret)};out.push(it)}});
 return out;
}
async function getOffers(date,ret,lim){
 const key=[S.F.l,S.T.l,date,ret,lim].join("|");if(S.cache[key])return S.cache[key];
