.p{font-size:22px;font-weight:700;text-align:right;display:flex;flex-direction:column;align-items:flex-end;flex:0 0 auto}.p small{font-size:12px;font-weight:400;color:var(--mu)}
.chip{background:var(--okb);color:var(--ok);border-radius:8px;padding:2px 8px;font-size:12px}
.tag{font-size:12px;color:var(--mu);background:var(--sg);border-radius:8px;padding:1px 8px;white-space:nowrap}.tag.sp{color:var(--ac)}
.empty{text-align:center;color:var(--mu);padding:28px 16px}
.cp{background:var(--cd);border-radius:12px;padding:12px 16px;margin:0 0 10px}.cp .t{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:4px}
.lnk{color:var(--ac);font-weight:500;margin-top:8px;display:inline-block}.del{color:#ff3b30;margin-top:6px;display:inline-block}
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:25;display:flex;justify-content:center;background:var(--bar);-webkit-backdrop-filter:blur(20px);backdrop-filter:blur(20px);border-top:.5px solid var(--sp);padding-bottom:env(safe-area-inset-bottom,0px)}
.tabs>div{display:flex;width:100%;max-width:560px}
.tabs button{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:7px 0 6px;font-size:10.5px;color:var(--mu);text-align:center}.tabs button[aria-selected="true"]{color:var(--ac)}
.tabs svg.i{width:26px;height:26px;stroke-width:1.8}
.ov{position:fixed;inset:0;background:#0000006b;display:none;z-index:50;overscroll-behavior:contain}.ov.on{display:flex;align-items:flex-end;justify-content:center}
.sheet{width:100%;max-width:560px;height:88vh;height:88dvh;background:var(--bg);border-radius:14px 14px 0 0;display:flex;flex-direction:column;animation:up .26s ease-out;overflow:hidden}
.sheet.sm{height:auto;max-height:88dvh}
@keyframes up{from{transform:translateY(40%);opacity:.5}}
.sh{display:flex;align-items:center;justify-content:space-between;padding:14px 16px 8px;font-weight:600}.sh button{color:var(--ac);font-weight:500}
.sb{overflow-y:auto;overflow-x:hidden;overscroll-behavior:contain;padding:0 16px calc(16px + env(safe-area-inset-bottom,0px));flex:1;min-height:0}
.sr{display:block;width:100%;height:38px;border-radius:10px;background:var(--sg);padding:0 12px;margin:0 0 12px;font-size:17px;-webkit-appearance:none;appearance:none}
.gh{color:var(--mu);font-size:13px;margin:14px 16px 6px}
.pk .row{background:var(--cd);min-height:48px}.pk .row b{display:block;font-weight:500;overflow:hidden;text-overflow:ellipsis}.pk .row small{display:block;color:var(--mu);font-size:13px}.pk .row>span{min-width:0}
.pk .grp{margin-bottom:6px}.pk .ind{padding-left:32px}
.ds{display:flex;justify-content:space-between;gap:12px;padding:10px 16px;position:relative}.ds+.ds::before{content:"";position:absolute;left:16px;right:0;top:0;height:.5px;background:var(--sp)}.ds>span:first-child{color:var(--mu);flex:0 0 auto}.ds>span:last-child{text-align:right;min-width:0;overflow-wrap:anywhere}
.toast{position:fixed;left:50%;bottom:calc(74px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:#333c;color:#fff;-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);padding:10px 16px;border-radius:14px;max-width:90vw;z-index:60;display:none;font-size:15px;text-align:center}
@media (prefers-reduced-motion:reduce){.sheet{animation:none}*{transition:none!important}}
</style>
</head>
