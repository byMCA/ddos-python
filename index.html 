 const res=await Promise.allSettled(ps.map(([a,b])=>CONFIG.API_URL?live(a,b,date,ret):Promise.resolve(demo(a,b,date,ret,ps.length==1))));
 const ok=res.filter(r=>r.status=="fulfilled");if(!ok.length)throw new Error("fail");
 return S.cache[key]=ok.flatMap(r=>r.value);
}

