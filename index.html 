.day.low{background:var(--okb)}.day.low b{color:var(--ok)}.day.sel{box-shadow:inset 0 0 0 2px var(--ac)}.day:disabled{opacity:.35}
.cap{color:var(--mu);font-size:12px;margin:0 4px 14px}
