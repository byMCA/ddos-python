});
document.addEventListener("input",e=>{if(e.target.id=="q")renderPick(e.target.value);if(e.target.id=="aq")renderAir(e.target.value)});
$("#dep").addEventListener("change",e=>{if($("#ret").value<e.target.value)$("#ret").value=addD(e.target.value,7)});
addEventListener("scroll",()=>$("#bar").classList.toggle("sc",scrollY>40),{passive:true});
["gesturestart","gesturechange","gestureend"].forEach(g=>document.addEventListener(g,e=>e.preventDefault()));
const inp=e=>e.target.closest&&e.target.closest("input");
document.addEventListener("contextmenu",e=>{if(!inp(e))e.preventDefault()});
["copy","cut","dragstart","selectstart"].forEach(g=>document.addEventListener(g,e=>{if(!inp(e))e.preventDefault()}));
document.addEventListener("touchmove",e=>{if(e.touches.length>1)e.preventDefault()},{passive:false});
</script>
</body>
</html>
