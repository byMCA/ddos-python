<script>
/* ===== AYARLAR ===== */
const CONFIG={
 API_URL:"",          /* Kendi sunucunuz (server.js) adresi. Örn: "https://api.siteniz.com". Boşsa örnek veri gösterilir. */
 CAMPAIGNS_URL:"",    /* Kampanya JSON adresi (isteğe bağlı). Biçim: [{airline:"TK",title:"...",pct:5,cond:"...",until:"2027-03-31",sponsored:false,url:""}] */
 DATA_URL:"https://raw.githubusercontent.com/jpatokal/openflights/master/data/" /* Ülke/havalimanı/havayolu verisi. Üretimde dosyaları kendi sunucunuza kopyalayın. */
};
const $=s=>document.querySelector(s);
const TRN=Object.fromEntries("Istanbul:İstanbul,London:Londra,Rome:Roma,Munich:Münih,Vienna:Viyana,Athens:Atina,Moscow:Moskova,Zurich:Zürih,Cologne:Köln,Prague:Prag,Brussels:Brüksel,Copenhagen:Kopenhag,Warsaw:Varşova,Venice:Venedik,Naples:Napoli,Florence:Floransa,Geneva:Cenevre,Cairo:Kahire,Seoul:Seul,Beijing:Pekin,Singapore:Singapur,Bucharest:Bükreş,Belgrade:Belgrad,Lisbon:Lizbon,Seville:Sevilla,Edinburgh:Edinburg,Nicosia:Lefkoşa,Tbilisi:Tiflis,Baku:Bakü,Damascus:Şam,Baghdad:Bağdat,Tehran:Tahran,Jeddah:Cidde,Milan:Milano,Turin:Torino,Geneva:Cenevre,Dusseldorf:Düsseldorf,Hanover:Hannover,Nuremberg:Nürnberg,Gothenburg:Göteborg,Mumbai:Mumbai,Bangkok:Bangkok,Moscow:Moskova,Saint Petersburg:Sankt Petersburg,Izmir:İzmir,Adana:Adana,Diyarbakir:Diyarbakır,Kayseri:Kayseri,Mugla:Muğla,Sanliurfa:Şanlıurfa,Eskisehir:Eskişehir,Elazig:Elazığ,Erzurum:Erzurum,Van:Van,Nevsehir:Nevşehir,Kahramanmaras:Kahramanmaraş".split(",").map(x=>x.split(":")));
const norm=s=>(s||"").toLocaleLowerCase("tr").normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/ı/g,"i");
const iso=d=>{const p=n=>String(n).padStart(2,"0");return d.getFullYear()+"-"+p(d.getMonth()+1)+"-"+p(d.getDate())};
const D=s=>new Date(s+"T12:00"),addD=(s,n)=>{const d=D(s);d.setDate(d.getDate()+n);return iso(d)};
const today=iso(new Date()),dd=s=>Math.round((D(s)-D(today))/864e5);
const fmt=(s,o)=>D(s).toLocaleDateString("tr-TR",o||{day:"numeric",month:"short"});
const money=(n,c)=>{try{return new Intl.NumberFormat("tr-TR",{style:"currency",currency:c,maximumFractionDigits:0}).format(n)}catch(e){return Math.round(n)+" "+c}};
const hmm=m=>Math.floor(m/60)+" sa "+(m%60)+" dk";
function csv(l){const o=[];let c="",q=0;for(let i=0;i<l.length;i++){const h=l[i];if(h=='"')q=!q;else if(h==","&&!q){o.push(c);c=""}else c+=h}o.push(c);return o.map(x=>x==="\\N"?"":x)}
function toast(t){const e=$("#toast");e.textContent=t;e.style.display="block";clearTimeout(toast.t);toast.t=setTimeout(()=>e.style.display="none",3000)}
function store(k,v){try{if(v===undefined)return JSON.parse(localStorage.getItem(k)||"null");localStorage.setItem(k,JSON.stringify(v))}catch(e){return null}}
let mem=[];const getAl=()=>store("mars_alarms")||mem,setAl=a=>{mem=a;store("mars_alarms",a)};

/* ===== REFERANS VERİ: tüm ülkeler, havalimanları, havayolları ===== */
const CLOSED=["ISL","TXL","THF","SXF","HHN2"];
const BYC={},GRP=[],CTRY={},AIRL=[],AIRN={};let CAMP=[],dataState="loading";
async function txt(f){const r=await fetch(CONFIG.DATA_URL+f+".dat");if(!r.ok)throw new Error(f);return r.text()}
async function loadData(){
 try{
  const [a,c,l]=await Promise.all([txt("airports"),txt("countries"),txt("airlines")]);
  let rn;try{rn=new Intl.DisplayNames(["tr"],{type:"region"})}catch(e){}
  const ISO={};c.split("\n").forEach(x=>{if(x){const f=csv(x);ISO[f[0]]=f[1]}});
  const G={};
  a.split("\n").forEach(x=>{
   if(!x)return;const f=csv(x),k=f[4];if(f[12]!="airport"||!/^[A-Z]{3}$/.test(k)||CLOSED.includes(k))return;
   const cn=f[3],ci=ISO[cn]||"";let C=CTRY[cn];
   if(!C){let tr=cn;try{if(rn&&ci)tr=rn.of(ci)||cn}catch(e){}C=CTRY[cn]={en:cn,tr,iso:ci,ap:[]}}
   const city=f[2]||f[1],gk=city+"|"+cn;let g=G[gk];
   if(!g){g=G[gk]={n:TRN[city]||city,en:city,c:C,ap:[]};GRP.push(g)}
   const ap={k,name:f[1],g,lat:+f[6],lon:+f[7],tz:f[11],rank:0};g.ap.push(ap);C.ap.push(ap);BYC[k]=ap});
  GRP.forEach(g=>g.s=norm(g.n+" "+g.en+" "+g.c.tr+" "+g.c.en+" "+g.ap.map(p=>p.k+" "+p.name).join(" ")));
  const seen={};l.split("\n").forEach(x=>{if(!x)return;const f=csv(x);if(f[7]=="Y"&&/^[A-Z0-9]{2}$/.test(f[3])&&!seen[f[3]]){seen[f[3]]=1;AIRL.push({c:f[3],n:f[1]});AIRN[f[3]]=f[1]}});
  AIRL.sort((p,q)=>p.n.localeCompare(q.n));
  dataState="ok";
  S.F=selCity(BYC.IST.g);S.T=selCity(BYC.FCO.g);paint();
  fetch(CONFIG.DATA_URL+"routes.dat").then(r=>r.text()).then(t=>{t.split("\n").forEach(x=>{const f=x.split(",");[f[2],f[4]].forEach(k=>{if(BYC[k])BYC[k].rank++})});if(S.F)S.F=refresh(S.F);if(S.T)S.T=refresh(S.T);if($("#q"))renderPick($("#q").value)}).catch(()=>{});
 }catch(e){dataState="err";$("#dnote").textContent="Havalimanı verisi yüklenemedi. Sayfayı yenileyip tekrar deneyin."}
}
const rk=k=>BYC[k]?BYC[k].rank:0;
const top=(ps,n)=>ps.slice().sort((a,b)=>b.rank-a.rank).slice(0,n);
const selAp=p=>({l:p.g.ap.length>1?p.name:p.g.n,s:p.g.n+", "+p.g.c.tr+" · "+p.k,codes:[p.k]});
